+function withCacheBust(url) {
+  const sep = url.includes("?") ? "&" : "?";
+  return `${url}${sep}v=${Date.now()}`;
+}
+
+async function fetchJSONRequired(url, label) {
+  const finalUrl = withCacheBust(url);
+  const resp = await fetch(finalUrl, { cache: "no-store" });
+  if (!resp.ok) {
+    throw new Error(`[required] ${label || url} 加载失败: HTTP ${resp.status} ${url}`);
+  }
+  return await resp.json();
+}
+
+async function fetchJSONOptional(url, label, fallback) {
+  const finalUrl = withCacheBust(url);
+  try {
+    const resp = await fetch(finalUrl, { cache: "no-store" });
+    if (!resp.ok) {
+      console.warn(`[optional] ${label || url} 不存在: HTTP ${resp.status}`, url);
+      return fallback;
+    }
+    return await resp.json();
+  } catch (err) {
+    console.warn(`[optional] ${label || url} 加载异常`, err);
+    return fallback;
+  }
+}
+
+function normalizeRows(data) {
+  if (!data) return [];
+  if (Array.isArray(data)) return data;
+  if (Array.isArray(data.rows)) return data.rows;
+  if (Array.isArray(data.data)) return data.data;
+  if (Array.isArray(data.items)) return data.items;
+  if (Array.isArray(data.records)) return data.records;
+  return [];
+}
+
+function setLoadingText(text) {
+  const el = document.getElementById("loading");
+  if (el) el.textContent = text;
+}
+
+function hideLoadingOverlay() {
+  const el = document.getElementById("loading");
+  if (el) el.style.display = "none";
+}
+
+function escapeHtml(s) {
+  return String(s)
+    .replaceAll("&", "&amp;")
+    .replaceAll("<", "&lt;")
+    .replaceAll(">", "&gt;")
+    .replaceAll('"', "&quot;")
+    .replaceAll("'", "&#039;");
+}
+
+function renderLoadError(err) {
+  const target = document.getElementById("main-content") || document.body;
+  const msg = err && err.message ? err.message : String(err);
+  const html = `
+    <div class="load-error" style="margin:16px 0;padding:14px 16px;border:1px solid #fecaca;background:#fff1f2;color:#991b1b;border-radius:8px;line-height:1.6;">
+      <div style="font-weight:700;margin-bottom:6px;">数据加载失败</div>
+      <div>${escapeHtml(msg)}</div>
+      <div style="color:#7f1d1d;margin-top:6px;">
+        请确认：<br>
+        1. 已在项目根目录启动 <code>python -m http.server 8060</code><br>
+        2. 已执行 <code>python scripts/export_interactive_dashboard_data.py</code><br>
+        3. 强制刷新：Ctrl+Shift+R
+      </div>
+    </div>
+  `;
+  target.insertAdjacentHTML("afterbegin", html);
+}
+
